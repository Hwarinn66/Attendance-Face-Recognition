# Copy to backend/.env (local runs) or provide as real environment variables (containers).
# NEVER commit real values. Every value below is a placeholder.

# --- docker compose only -------------------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM

# --- core -------------------------------------------------------------------------------------------
APP_ENV=development                      # development | test | production
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://absen:CHANGE_ME@127.0.0.1:5432/absen
# Used only by the test suite; it is dropped/recreated by tests — never point it at real data.
TEST_DATABASE_URL=postgresql+psycopg://absen:CHANGE_ME@127.0.0.1:5432/absen_test
# Used only by Playwright E2E; truncated and reseeded on every run (name must end in _e2e).
E2E_DATABASE_URL=postgresql+psycopg://absen:CHANGE_ME@127.0.0.1:5432/absen_e2e

# --- browser / cookies --------------------------------------------------------------------------------
# Comma-separated origins allowed to make state-changing requests (Origin check) and CORS.
ALLOWED_ORIGINS=http://localhost:3000
# Must be true in production (HTTPS). Local http://localhost development needs false.
COOKIE_SECURE=false
SESSION_ABSOLUTE_TTL_MINUTES=720
SESSION_IDLE_TIMEOUT_MINUTES=60
# Set true only when running behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_FORWARDED_FOR=false

# --- biometric template encryption ----------------------------------------------------------------
# AES-256-GCM keyring: "kid:base64(32 random bytes)[,older_kid:base64...]". First key encrypts.
# Generate: python -c "import os,base64;print('k'+__import__('datetime').date.today().strftime('%Y%m')+':'+base64.b64encode(os.urandom(32)).decode())"
# Store in a secret manager in production. Losing all keys makes every template unreadable.
BIOMETRIC_ENCRYPTION_KEYS=kREPLACE:REPLACE_WITH_BASE64_32_BYTES

# --- vision models -----------------------------------------------------------------------------------
# onnx = real pretrained models in backend/weights (run scripts/fetch_models.py + convert_minifasnet.py)
# fake = TEST FIXTURE ONLY; refused unless APP_ENV=test
VISION_PROVIDER=onnx
RECOGNIZER=sface                         # sface (Apache-2.0, default) | arcface (InsightFace; non-commercial weights)
# MATCH_THRESHOLD=0.363                  # sface default = OpenCV Zoo published value; REQUIRED for arcface
# MATCH_UNCERTAINTY_MARGIN=0.05
# required = fail closed when PAD is missing (mandatory in production); disabled = development only
PAD_MODE=required
# PAD_THRESHOLD=0.80
# PAD_UNCERTAINTY_MARGIN=0.10
# Head movements the liveness challenge may request (look_up is supported but off by default; see
# docs/BIOMETRICS.md). CHALLENGE_STEPS=4 gives 24 possible sequences with the default three actions.
# CHALLENGE_ACTIONS=turn_left,turn_right,look_down
# active = random head-movement prompts (default, stronger); passive = steady frontal capture only (weaker,
# see SECURITY.md "Known limitations")
# LIVENESS_CHALLENGE=active
# CHALLENGE_STEPS=3
INFERENCE_WORKERS=2

# --- development seed (honoured only when APP_ENV=development) ---------------------------------------
# DEV_SEED_ADMIN_EMAIL=admin@example.test
# DEV_SEED_ADMIN_PASSWORD=choose-a-long-unique-password
